# ============================================================================
#  Пример окружения. Скопируйте в .env и заполните реальными значениями.
#  cp .env.example .env
# ============================================================================

# --- Сеть и RPC (Helius) ---------------------------------------------------
SOLANA_NETWORK=mainnet-beta
HELIUS_API_KEY=your-helius-api-key
# Необязательные переопределения; если пусто — строятся из HELIUS_API_KEY
RPC_HTTP_URL=
RPC_WS_URL=

# --- Включённые DEX --------------------------------------------------------
# Только Pump.fun (bonding curve + PumpSwap AMM). Чтобы вернуть Raydium:
# ENABLED_DEX=pump_fun,raydium
ENABLED_DEX=pump_fun

# --- Кошелёк ---------------------------------------------------------------
# Приватный ключ в base58 (НЕ публикуйте и не коммитьте!). Оставьте пустым,
# если используете файл keypair.
WALLET_PRIVATE_KEY=
# Путь к JSON keypair (формат solana-keygen). Используется, если ключ выше пуст.
WALLET_KEYPAIR_PATH=./keys/id.json

# --- Параметры торговли ----------------------------------------------------
TRADE_AMOUNT_SOL=0.02
BUY_SLIPPAGE_PCT=15.0
# Дисконт первой попытки продажи; если транзакция откатилась, бот повторяет
# её по свежей котировке с порогом 0 («лестница выхода»)
SELL_SLIPPAGE_PCT=25.0
# AMM-пулы: минимальный полный резерв, SOL
MIN_POOL_SOL=30.0
# Bonding curve: минимальные РЕАЛЬНЫЕ резервы, SOL (виртуальные = реальные
# + 30 SOL всегда; порог по виртуальным проходил бы для каждого токена)
MIN_REAL_POOL_SOL=80.0
# Окно надёжности токена: входы только по токенам старше 60 c
TOKEN_RELIABLE_SECONDS=60.0
# Максимум входов по одному mint (вход + усреднения)
MAX_ENTRIES_PER_MINT=10
MAX_PRICE_IMPACT_PCT=5.0
# Сколько позиций может быть открыто одновременно
# Лимит свободного капитала, SOL (пусто = без лимита)
CAPITAL_SOL=

# --- Память позиций (SQLite) -----------------------------------------------
# Путь к БД позиций; пусто = вести учёт только в памяти (потеря при рестарте)
PORTFOLIO_DB_PATH=data/bot.db
# Отдельная БД для dry-run (бумажные позиции не смешиваются с боевыми)
PORTFOLIO_DB_DRY_PATH=data/bot_dry.db

# --- Канал отправки ---------------------------------------------------------
# rpc — обычная транзакция через Helius (без Jito-чаевых);
# jito — бандл с чаевыми (JITO_TIP_SOL) и анти-MEV.
EXECUTION_VENUE=rpc

# --- Jito (только для EXECUTION_VENUE=jito) --------------------------------
JITO_TIP_SOL=0.005
JITO_BLOCK_ENGINE_URL=https://frankfurt.mainnet.block-engine.jito.wtf
JITO_REGION=frankfurt
# Ждать подтверждения (getBundleStatuses/getSignatureStatuses) перед учётом
JITO_REQUIRE_CONFIRMATION=true
JITO_CONFIRM_TIMEOUT_SECONDS=10.0
JITO_CONFIRM_POLL_SECONDS=0.5

# --- Compute Budget --------------------------------------------------------
COMPUTE_UNIT_LIMIT=200000
# 1,000,000 µL/CU при CU 200,000 ≈ 0.0002 SOL на транзакцию.
# Практика GMGN/снайперов: суммарно 0.0001–0.005 SOL; 100000 µL/CU (~0.00002)
# — транзакции стоят в очереди и отваливаются по таймауту.
PRIORITY_FEE_MICRO_LAMPORTS=1000000

# --- Вход (momentum) -------------------------------------------------------
# Окно анализа в секундах (в ТЗ 3–5 c для входных триггеров)
ENTRY_WINDOW_SECONDS=5.0
BUY_SELL_RATIO_THRESHOLD=0.70
VOLUME_VELOCITY_THRESHOLD=1.2

# --- Выход (TP / SL / trailing / exhaustion) -------------------------------
TP1_PCT=30.0
TP2_PCT=50.0
TP1_SIZE_PCT=50.0
TRAILING_STOP_PCT=10.0
HARD_STOP_LOSS_PCT=30.0
# Окно для детекта затухания импульса (в ТЗ 2 c)
EXIT_WINDOW_SECONDS=2.0
EXIT_RATIO_THRESHOLD=0.40
LARGE_SELL_SOL=1.0
# Защита от «зависшей» позиции: принудительный выход
MAX_HOLD_SECONDS=180.0

# --- Безопасность контракта (контур отбора до торговли) --------------------
# Правила применяются службой отбора (core/screening.py) при первом
# обнаружении токена, ДО любых торговых сигналов; горячий путь торговли
# RPC-запросов по безопасности не делает.
# TTL кэша данных безопасности в RPC-резолвере, c
SECURITY_TTL_SECONDS=30.0
MIN_LP_BURNED_PCT=90.0
# TTL вердикта отбора до повторной проверки, c
SCREEN_RECHECK_SECONDS=600.0

# --- Jupiter (fallback-маршрут исполнения) ---------------------------------
# Запасной маршрут продажи/покупки для токенов, мигрировавших с bonding
# curve на AMM. При удержании позиции дольше нескольких секунд миграция —
# штатный сценарий, и без fallback продать позицию нечем. Для live с
# холдами > пары секунд используйте true; dry-run Jupiter не использует.
USE_JUPITER_FALLBACK=false
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# --- Логирование -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Транспорт / устойчивость ----------------------------------------------
RPC_TIMEOUT_SECONDS=10
RPC_MAX_RETRIES=3
WS_INITIAL_RECONNECT_DELAY=0.5
WS_MAX_RECONNECT_DELAY=30.0

# --- Обслуживание пайплайна ------------------------------------------------
# Пауза перед повторным входом по пулу после неуспешного ордера, c
RETRY_COOLDOWN_SECONDS=2.0
# Интервал обслуживания (чистка пулов, сводка в лог), c
MAINTENANCE_INTERVAL_SECONDS=60.0
# Возраст «молчания» пула до удаления из реестра, c
STALE_POOL_SECONDS=600.0

# --- Веб-дашборд (http://127.0.0.1:8787) -----------------------------------
# Вся картина торговли в браузере: позиции, PnL, покупки/продажи, отбор.
# На VPS: ssh -L 8787:127.0.0.1:8787 user@vps, затем открыть localhost:8787.
# 0.0.0.0 наружу — только с закрытым фаерволом, аутентификации нет.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_INTERVAL_SECONDS=2.0
# Логин/пароль страницы (ручные кнопки сделок!); пароль пуст = без аутентификации
DASHBOARD_USER=home
DASHBOARD_PASSWORD=123

